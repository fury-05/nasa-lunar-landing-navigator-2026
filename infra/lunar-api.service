[Unit]
Description=Lunar Navigator API
After=network.target postgresql.service redis-server.service

[Service]
User=lunar
WorkingDirectory=/opt/lunar/current
EnvironmentFile=/etc/lunar/lunar.env
ExecStart=/opt/lunar/current/.venv/bin/gunicorn lunar_api.main:app -k uvicorn.workers.UvicornWorker -w 3 -b 127.0.0.1:8000 --timeout 60 --graceful-timeout 30 --access-logfile -
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/lunar

[Install]
WantedBy=multi-user.target
